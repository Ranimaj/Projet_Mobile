rules_version = '2';

// Règles de sécurité Firestore — CampusConnect
// Principe : lecture publique (y compris visiteur non connecté) sur le
// contenu des 4 modules, écriture réservée aux utilisateurs authentifiés
// propriétaires de leur contenu, modération réservée aux admins.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isRecruiter() {
      return isSignedIn() && userRole() == 'recruiter';
    }

    // --- Gestion Utilisateurs ---
    // Clés modifiées par la requête courante (update uniquement).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Champs du profil qu'un utilisateur ne peut jamais fixer lui-même.
    function touchesProtectedUserFields() {
      return changedKeys().hasAny([
        'role', 'isVerifiedStudent', 'email', 'createdAt', 'ratingAverage', 'ratingCount',
        'disabled'
      ]);
    }

    // Le téléphone n'est inscrit dans le profil que s'il correspond au numéro
    // réellement vérifié (présent dans le jeton Firebase après liaison OTP).
    function phoneChangeIsVerified() {
      return !changedKeys().hasAny(['isPhoneVerified', 'phoneNumber'])
        || (('phone_number' in request.auth.token)
            && request.resource.data.phoneNumber == request.auth.token.phone_number
            && request.resource.data.isPhoneVerified == true);
    }

    // Le propriétaire ne peut que soumettre sa carte étudiante (status
    // 'pending') : jamais 'verified' / 'rejected' ni les champs reviewed*,
    // réservés à l'admin.
    // Le propriétaire ne soumet sa carte que vers « pending », avec une
    // photo rangée sous SON dossier student_cards/{userId}/ (pas celle d'un
    // autre) et une date d'envoi.
    function studentCardChangeIsSubmission(userId) {
      return !changedKeys().hasAny(['studentCard'])
        || (request.resource.data.studentCard.status == 'pending'
            && request.resource.data.studentCard.imagePath is string
            && request.resource.data.studentCard.imagePath.matches('student_cards/' + userId + '/.*')
            && request.resource.data.studentCard.submittedAt is timestamp
            && !('reviewedBy' in request.resource.data.studentCard)
            && !('reviewedAt' in request.resource.data.studentCard)
            && !('rejectReason' in request.resource.data.studentCard));
    }

    match /users/{userId} {
      allow read: if true; // profils publics (nom, filière) visibles par tous

      // Un utilisateur ne crée que son propre profil, avec les valeurs par
      // défaut : rôle et statuts de vérification ne se décrètent pas.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.isVerifiedStudent == false
        && request.resource.data.isPhoneVerified == false
        && request.resource.data.ratingAverage == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.studentCard.status == 'none'
        && request.resource.data.disabled == false;

      allow update: if isAdmin()
        || (isOwner(userId) && !touchesProtectedUserFields() && phoneChangeIsVerified()
            && studentCardChangeIsSubmission(userId));

      allow delete: if isOwner(userId) || isAdmin();
    }

    // --- Gestion Vente & Don ---
    function validArticle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && (data.price == null || (data.price is number && data.price >= 0))
        && data.get('imageUrls', []).size() <= 6;
    }

    // Un favori ne touche que l'uid de celui qui clique (ajout ou retrait).
    function favoriteChangeIsOwn() {
      let before = resource.data.get('favoritedBy', []).toSet();
      let after = request.resource.data.get('favoritedBy', []).toSet();
      return after.difference(before).union(before.difference(after))
        .hasOnly([request.auth.uid]);
    }

    // Une vue ajoute exactement 1 au compteur.
    function viewCountIsIncrement() {
      return request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0) + 1;
    }

    // Tout utilisateur connecté (non propriétaire) ne peut modifier que ses
    // favoris et le compteur de vues.
    function isFavoriteOrViewUpdate() {
      return changedKeys().hasOnly(['favoritedBy', 'viewCount'])
        && (!changedKeys().hasAny(['favoritedBy']) || favoriteChangeIsOwn())
        && (!changedKeys().hasAny(['viewCount']) || viewCountIsIncrement());
    }

    match /articles/{articleId} {
      allow read: if true; // visible par le visiteur non connecté
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
        && validArticle(request.resource.data);
      allow update: if isSignedIn() && (
        ((resource.data.ownerId == request.auth.uid || isAdmin())
          && request.resource.data.ownerId == resource.data.ownerId
          && validArticle(request.resource.data))
        || isFavoriteOrViewUpdate());
      allow delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Messagerie Vente & Don : visible uniquement par l'acheteur et le vendeur.
    match /conversations/{conversationId} {
      // Lire une conversation absente est permis (on vérifie si elle existe
      // avant de la créer) ; une conversation existante, seulement par ses
      // deux participants.
      allow get: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.sellerId in request.resource.data.participants
        && conversationId == request.resource.data.articleId + '_' + request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId;

      match /messages/{messageId} {
        function participants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if isSignedIn() && request.auth.uid in participants();
        allow create: if isSignedIn()
          && request.auth.uid in participants()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
      }
    }

    // --- Gestion Annonces ---
    match /annonces/{annonceId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        (request.resource.data.category != 'Officielle' || isAdmin());
      allow update: if isAdmin(); // épinglage / modération réservés à l'admin
      allow delete: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // --- Gestion Événements ---
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.organizerId == request.auth.uid;
      allow update: if isSignedIn(); // inscription/désinscription par tout utilisateur connecté
      allow delete: if isSignedIn() &&
        (resource.data.organizerId == request.auth.uid || isAdmin());
    }

    // --- Gestion Stage & Emploi ---
    match /job_offers/{offerId} {
      allow read: if true;
      allow create: if isRecruiter() && request.resource.data.recruiterId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.recruiterId == request.auth.uid || isAdmin());
    }

    match /applications/{applicationId} {
      // une candidature n'est visible que par son auteur, le recruteur
      // concerné, ou un admin — jamais par le grand public ni le visiteur.
      allow read: if isSignedIn() &&
        (resource.data.candidateId == request.auth.uid || isRecruiter() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.candidateId == request.auth.uid;
      allow update: if isSignedIn() && (isRecruiter() || isAdmin()); // changement de statut
      allow delete: if isSignedIn() &&
        (resource.data.candidateId == request.auth.uid || isAdmin());
    }
  }
}
