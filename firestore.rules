rules_version = '2';

// Règles de sécurité Firestore — CampusConnect
// Principe : lecture publique (y compris visiteur non connecté) sur le
// contenu des 4 modules, écriture réservée aux utilisateurs authentifiés
// propriétaires de leur contenu, modération réservée aux admins.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isRecruiter() {
      return isSignedIn() && userRole() == 'recruiter';
    }

    // --- Gestion Utilisateurs ---
    match /users/{userId} {
      allow read: if true; // profils publics (nom, filière) visibles par tous
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId);
    }

    // --- Gestion Vente & Don ---
    match /articles/{articleId} {
      allow read: if true; // visible par le visiteur non connecté
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // --- Gestion Annonces ---
    match /annonces/{annonceId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        (request.resource.data.category != 'Officielle' || isAdmin());
      allow update: if isAdmin(); // épinglage / modération réservés à l'admin
      allow delete: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // --- Gestion Événements ---
    // Règles v2 : miroir serveur des contrôles de l'app. On utilise
    // data.get(champ, défaut) car les anciens documents n'ont pas les
    // nouveaux champs, et request.time (horloge du serveur) pour tout ce qui
    // dépend de l'heure : un téléphone mal réglé ne peut pas tricher.
    match /events/{eventId} {
      // Champs modifiés par la requête (ajoutés, supprimés ou changés).
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Contenu valide d'un événement (création et modification).
      // Capacité absente ou null = places illimitées.
      function validEvent(d) {
        let end = d.get('endDate', d.startDate + duration.value(2, 'h'));
        let cap = d.get('capacity', null);
        let status = d.get('status', 'active');
        let reason = d.get('cancelReason', '');
        return d.title is string && d.title.size() >= 3 && d.title.size() <= 80 &&
          d.description is string && d.description.size() >= 10 && d.description.size() <= 1000 &&
          d.location is string && d.location.size() >= 3 && d.location.size() <= 100 &&
          d.category in ['Conférence', 'Job Fair', 'Sport', 'Culture', 'Associatif'] &&
          d.startDate is timestamp && end is timestamp &&
          end > d.startDate && end <= d.startDate + duration.value(72, 'h') &&
          (cap == null || (cap is int && cap >= 1 && cap <= 5000)) &&
          (status == 'active' ||
            (status == 'cancelled' && reason is string && reason.size() >= 5 && reason.size() <= 200));
      }

      // Organisateur ou admin : modifie le contenu, annule, gère la présence ;
      // jamais organizerId ni createdAt ; capacité >= nombre d'inscrits ;
      // un événement annulé ne redevient pas actif.
      function isOrganizerEdit() {
        let after = request.resource.data;
        let cap = after.get('capacity', null);
        return (resource.data.organizerId == request.auth.uid || isAdmin()) &&
          !changedKeys().hasAny(['organizerId', 'createdAt']) &&
          validEvent(after) &&
          (cap == null || cap >= after.get('registeredUserIds', []).size()) &&
          !(resource.data.get('status', 'active') == 'cancelled' && after.get('status', 'active') == 'active');
      }

      // Autre utilisateur : ne touche qu'à registeredUserIds, pour ajouter OU
      // retirer son propre uid, seulement si l'événement est actif, avant son
      // début (heure du serveur), et sans dépasser la capacité.
      function isOwnRegistrationChange() {
        let before = resource.data.get('registeredUserIds', []);
        let after = request.resource.data.get('registeredUserIds', []);
        let me = [request.auth.uid].toSet();
        let cap = resource.data.get('capacity', null);
        return changedKeys().hasOnly(['registeredUserIds']) &&
          resource.data.get('status', 'active') == 'active' &&
          request.time < resource.data.startDate && (
            // inscription : avant + moi, dans la limite des places
            (!(request.auth.uid in before) &&
              after.size() == before.size() + 1 &&
              after.toSet() == before.toSet().union(me) &&
              (cap == null || after.size() <= cap)) ||
            // désinscription : avant - moi
            ((request.auth.uid in before) &&
              after.size() == before.size() - 1 &&
              after.toSet() == before.toSet().difference(me))
          );
      }

      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.organizerId == request.auth.uid &&
        validEvent(request.resource.data) &&
        request.resource.data.startDate > request.time &&
        request.resource.data.get('status', 'active') == 'active' &&
        request.resource.data.get('registeredUserIds', []).size() == 0 &&
        request.resource.data.get('checkedInUserIds', []).size() == 0;
      allow update: if isSignedIn() && (isOrganizerEdit() || isOwnRegistrationChange());
      // Organisateur : seulement sans inscrits (sinon il annule). Admin : toujours.
      allow delete: if isSignedIn() && (
        (resource.data.organizerId == request.auth.uid &&
          resource.data.get('registeredUserIds', []).size() == 0) ||
        isAdmin());
    }

    // --- Gestion Stage & Emploi ---
    match /job_offers/{offerId} {
      allow read: if true;
      allow create: if isRecruiter() && request.resource.data.recruiterId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.recruiterId == request.auth.uid || isAdmin());
    }

    match /applications/{applicationId} {
      // une candidature n'est visible que par son auteur, le recruteur
      // concerné, ou un admin — jamais par le grand public ni le visiteur.
      allow read: if isSignedIn() &&
        (resource.data.candidateId == request.auth.uid || isRecruiter() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.candidateId == request.auth.uid;
      allow update: if isSignedIn() && (isRecruiter() || isAdmin()); // changement de statut
      allow delete: if isSignedIn() &&
        (resource.data.candidateId == request.auth.uid || isAdmin());
    }
  }
}
